#!/bin/sh
# {{ ansible_managed }}
#
# CUPS backend: send the job to an SMB print queue using {{ siue_print_user }}'s
# Kerberos ticket, whoever submitted it. The queues shared to Windows use
# this, because a job arriving over the network has no local user for
# smbspool_krb5_wrapper to take a ticket from.
#
# Device URI: smb-{{ siue_print_user }}://<server>/<share>

[ $# -eq 0 ] && exit 0    # device discovery: nothing to advertise

export AUTH_UID={{ siue_print_uid }}
export AUTH_INFO_REQUIRED=negotiate
export DEVICE_URI="smb://${DEVICE_URI#smb-{{ siue_print_user }}://}"
exec /usr/libexec/samba/smbspool_krb5_wrapper "$@"
